{
  "name": "memento-vocabulary-videos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "tsx scripts/clean.ts",
    "ci": "npm run typecheck && npm test && npm run validate:all",
    "prompts": "tsx scripts/prompts.ts",
    "render": "tsx scripts/render.ts",
    "studio": "tsx scripts/studio.ts",
    "test": "tsx --test src/*.test.ts scripts/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "validate:all": "tsx scripts/validate.ts --all",
    "voice": "tsx scripts/generate-voice.ts",
    "voice:question": "tsx scripts/generate-question.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.506",
    "@remotion/media": "4.0.506",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.506"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}

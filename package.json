{
  "name": "memento",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "node --conditions=react-server --import tsx evals/runner.ts",
    "stage:telegram": "tsx scripts/configure-stage-telegram.ts",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.22",
    "@radix-ui/react-tabs": "^1.1.20",
    "@supabase/supabase-js": "2.57.4",
    "lucide-react": "^1.26.0",
    "next": "16.2.12",
    "openai": "6.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "26.1.0",
    "supabase": "2.113.0",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.23",
    "next": {
      "sharp": "0.35.3"
    }
  }
}
